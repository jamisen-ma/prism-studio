{
  "manifestVersion": 5,
  "id": "studio.prism.photoshop.bridge",
  "name": "Prism Studio Bridge",
  "version": "0.1.0",
  "main": "index.html",
  "host": [{"app": "PS", "minVersion": "25.0.0", "data": {"apiVersion": 2}}],
  "entrypoints": [{
    "type": "panel", "id": "prismBridge", "label": {"default": "Prism Studio"},
    "minimumSize": {"width": 280, "height": 360},
    "preferredDockedSize": {"width": 320, "height": 480},
    "preferredFloatingSize": {"width": 340, "height": 480}
  }],
  "requiredPermissions": {
    "network": {"domains": ["ws://127.0.0.1:43120"]},
    "localFileSystem": "plugin"
  }
}
